// TLS for coil streams, backed by rustls in the native `libtls` library.
// `tls::client::enable` / `tls::server::enable` run a handshake on a TCP
// `Stream` and return a `TlsStream`, which implements `io::Read`,
// `io::Write` and `io::Close`; `tls::error::TlsError` is the error of all
// of them.
pub use tls::stream::TlsStream;
