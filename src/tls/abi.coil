// Lower-level C ABI around `coil_tls_*`. Session.ptr is the native session
// pointer; Session.drop of a released ptr is a no-op. `tls::stream::TlsStream`
// reads and writes through `read_at` / `write_at` here. Prefer
// `tls::client::enable` for HTTP.
//
// Every native is in the `extern "tls"` block: in native code each is a
// direct C call, and an AOT `coil package` links libtls by name. Spawned
// threads call through the library the program loaded.

use io::{Stream, IoError};
use ffi::types::{Bytes, ConstBytes};
use tls::error::{TlsError, tls_error_from_name, io_error_from_name};

extern "tls" {
    fn coil_tls_last_error() -> string;
    fn coil_tls_alpn_cstr(int session) -> string;
    fn coil_tls_free(int session);
    fn coil_tls_client_enable(int fd, string host, int verify, string ca_pem, string ca_path, int timeout_ms, string alpn, int err_out) -> int;
    fn coil_tls_server_enable(int fd, string cert_pem, string key_pem, int timeout_ms, string client_ca_pem, string alpn, int err_out) -> int;
    fn coil_tls_disable(int session, int fd, int err_out);
    fn coil_tls_read(int session, int fd, Bytes buf, int len, int err_out) -> int;
    fn coil_tls_write(int session, int fd, ConstBytes buf, int len, int err_out) -> int;
    fn coil_tls_wants_write(int session) -> int;
}

class Session {
    pub ptr: int,
}

fn option_string(Option<string> v) -> string {
    return match v {
        Option::None => "",
        Option::Some(s) => s,
    };
}

fn verify_int(bool v) -> int {
    if v {
        return 1;
    }
    return 0;
}

impl Session {
    fn drop() {
        if self.ptr != 0 {
            let p = self.ptr;
            self.ptr = 0;
            coil_tls_free(p);
        }
    }

    pub fn release() -> int {
        let p = self.ptr;
        self.ptr = 0;
        return p;
    }
}

fn session_ptr_or_raise(int ptr) -> Result<int, TlsError> {
    if ptr == 0 {
        let name = coil_tls_last_error();
        if name == "" {
            raise TlsError::Io(IoError::Other);
        }
        raise tls_error_from_name(name);
    }
    return ptr;
}

fn wrap_session(int ptr) -> Result<Session, TlsError> {
    let p = session_ptr_or_raise(ptr)?;
    return new Session(p);
}

fn enable_client_fd(int fd, string host, bool verify, Option<string> ca_pem, Option<string> ca_path, int timeout_ms, string alpn) -> Result<Session, TlsError> {
    let ptr = coil_tls_client_enable(fd, host, verify_int(verify), option_string(ca_pem), option_string(ca_path), timeout_ms, alpn, 0);
    return wrap_session(ptr)?;
}

fn enable_server_fd(int fd, string cert_pem, string key_pem, int timeout_ms, string client_ca_pem, string alpn) -> Result<Session, TlsError> {
    let ptr = coil_tls_server_enable(fd, cert_pem, key_pem, timeout_ms, client_ca_pem, alpn, 0);
    return wrap_session(ptr)?;
}

// The socket's fd and a new client session on it.
fn create_client(Stream s, string host, bool verify, Option<string> ca_pem, Option<string> ca_path, int timeout_ms, string alpn) -> Result<(int, int), TlsError> {
    let fd = s.fd().map_err(fn (IoError e) => TlsError::Io(e))?;
    let ptr = coil_tls_client_enable(fd, host, verify_int(verify), option_string(ca_pem), option_string(ca_path), timeout_ms, alpn, 0);
    return (fd, session_ptr_or_raise(ptr)?);
}

// The socket's fd and a new server session on it.
fn create_server(Stream s, string cert_pem, string key_pem, int timeout_ms, string client_ca_pem, string alpn) -> Result<(int, int), TlsError> {
    let fd = s.fd().map_err(fn (IoError e) => TlsError::Io(e))?;
    let ptr = coil_tls_server_enable(fd, cert_pem, key_pem, timeout_ms, client_ca_pem, alpn, 0);
    return (fd, session_ptr_or_raise(ptr)?);
}

fn disable(Session s, int fd) -> Result<(), TlsError> {
    if s.ptr == 0 {
        raise TlsError::Io(IoError::InvalidInput);
    }
    coil_tls_disable(s.ptr, fd, 0);
    return ();
}

fn alpn_at(int ptr) -> Result<string, TlsError> {
    if ptr == 0 {
        raise TlsError::Io(IoError::InvalidInput);
    }
    return coil_tls_alpn_cstr(ptr);
}

fn alpn_protocol(Session s) -> Result<string, TlsError> {
    return alpn_at(s.ptr)?;
}

// The `IoError` of a failed read or write, from the native side's last
// error: `IoError::Protocol` for a certificate or handshake failure.
fn last_io_error() -> IoError {
    let name = coil_tls_last_error();
    if name == "" {
        return IoError::Other;
    }
    return io_error_from_name(name);
}

// A TLS stream call's failure as a `TlsError`: `IoError::Protocol` is the
// native side's certificate or handshake failure, which it names.
fn stream_failure(IoError e) -> TlsError {
    if e != IoError::Protocol {
        return TlsError::Io(e);
    }
    if coil_tls_last_error() == "Certificate" {
        return TlsError::Certificate;
    }
    return TlsError::Handshake;
}

// Decrypted bytes into the front of `buf`: `Some(n)`, or `None` at the
// peer's close_notify or end of input.
fn read_at(int session, int fd, Vec<byte> buf) -> Result<Option<int>, IoError> {
    let n = coil_tls_read(session, fd, buf, buf.len(), 0);
    if n < 0 {
        raise last_io_error();
    }
    if n == 0 && buf.len() != 0 {
        return None;
    }
    return Some(n);
}

// How many bytes of `buf` the session took to send.
fn write_at(int session, int fd, readonly Vec<byte> buf) -> Result<int, IoError> {
    let n = coil_tls_write(session, fd, buf, buf.len(), 0);
    if n < 0 {
        raise last_io_error();
    }
    return n;
}

// Whether a WouldBlock retry waits for the socket to take writes (TLS
// records to send) rather than for data.
fn wants_write(int session) -> bool {
    return coil_tls_wants_write(session) == 1;
}

// close_notify to the peer and the session freed.
fn finish(int session, int fd) {
    coil_tls_disable(session, fd, 0);
    coil_tls_free(session);
}
