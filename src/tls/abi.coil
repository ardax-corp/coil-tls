// Lower-level C ABI around `coil_tls_*`. Session.ptr is the native session
// pointer. After Stream.attach, the Stream owns free; Session.drop of a
// released ptr is a no-op. Prefer `tls::client::enable` for HTTP.
//
// Every native is in the `extern "tls"` block: in native code each is a
// direct C call, and an AOT `coil package` links libtls by name. Spawned
// threads call through the library the program loaded.

use io::{Stream, IoError, write, read};
use tls::error::{TlsError, tls_error_from_name};

extern "tls" {
    fn coil_tls_last_error() -> string;
    fn coil_tls_alpn_cstr(int session) -> string;
    fn coil_tls_free(int session);
    fn coil_tls_client_enable(int fd, string host, int verify, string ca_pem, string ca_path, int timeout_ms, string alpn, int err_out) -> int;
    fn coil_tls_server_enable(int fd, string cert_pem, string key_pem, int timeout_ms, string client_ca_pem, string alpn, int err_out) -> int;
    fn coil_tls_disable(int session, int fd, int err_out);
    fn coil_tls_session_for_fd(int fd) -> int;
    fn coil_tls_stream_read_fn() -> int;
    fn coil_tls_stream_write_fn() -> int;
    fn coil_tls_stream_shutdown_fn() -> int;
    fn coil_tls_stream_free_fn() -> int;
}

class Session {
    pub ptr: int,
}

fn option_string(Option<string> v) -> string {
    return match v {
        Option::None => "",
        Option::Some(s) => s,
    };
}

fn verify_int(bool v) -> int {
    if v {
        return 1;
    }
    return 0;
}

impl Session {
    fn drop() {
        if self.ptr != 0 {
            let p = self.ptr;
            self.ptr = 0;
            coil_tls_free(p);
        }
    }

    pub fn release() -> int {
        let p = self.ptr;
        self.ptr = 0;
        return p;
    }
}

fn session_ptr_or_raise(int ptr) -> Result<int, TlsError> {
    if ptr == 0 {
        let name = coil_tls_last_error();
        if name == "" {
            raise TlsError::Io(IoError::Other);
        }
        raise tls_error_from_name(name);
    }
    return ptr;
}

fn wrap_session(int ptr) -> Result<Session, TlsError> {
    let p = session_ptr_or_raise(ptr)?;
    return new Session(p);
}

fn enable_client_fd(int fd, string host, bool verify, Option<string> ca_pem, Option<string> ca_path, int timeout_ms, string alpn) -> Result<Session, TlsError> {
    let ptr = coil_tls_client_enable(fd, host, verify_int(verify), option_string(ca_pem), option_string(ca_path), timeout_ms, alpn, 0);
    return wrap_session(ptr)?;
}

fn enable_server_fd(int fd, string cert_pem, string key_pem, int timeout_ms, string client_ca_pem, string alpn) -> Result<Session, TlsError> {
    let ptr = coil_tls_server_enable(fd, cert_pem, key_pem, timeout_ms, client_ca_pem, alpn, 0);
    return wrap_session(ptr)?;
}

fn create_client(Stream s, string host, bool verify, Option<string> ca_pem, Option<string> ca_path, int timeout_ms, string alpn) -> Result<int, TlsError> {
    let fd = s.fd().map_err(fn (IoError e) => TlsError::Io(e))?;
    let ptr = coil_tls_client_enable(fd, host, verify_int(verify), option_string(ca_pem), option_string(ca_path), timeout_ms, alpn, 0);
    return session_ptr_or_raise(ptr)?;
}

fn create_server(Stream s, string cert_pem, string key_pem, int timeout_ms, string client_ca_pem, string alpn) -> Result<int, TlsError> {
    let fd = s.fd().map_err(fn (IoError e) => TlsError::Io(e))?;
    let ptr = coil_tls_server_enable(fd, cert_pem, key_pem, timeout_ms, client_ca_pem, alpn, 0);
    return session_ptr_or_raise(ptr)?;
}

fn disable(Session s, int fd) -> Result<(), TlsError> {
    if s.ptr == 0 {
        raise TlsError::Io(IoError::InvalidInput);
    }
    coil_tls_disable(s.ptr, fd, 0);
    return ();
}

fn alpn_at(int ptr) -> Result<string, TlsError> {
    if ptr == 0 {
        raise TlsError::Io(IoError::InvalidInput);
    }
    return coil_tls_alpn_cstr(ptr);
}

fn alpn_protocol(Session s) -> Result<string, TlsError> {
    return alpn_at(s.ptr)?;
}

fn session_for_stream(Stream s) -> int {
    return match s.fd() {
        Result::Ok(fd) => coil_tls_session_for_fd(fd),
        Result::Err(_) => 0,
    };
}

fn disable_stream(Stream s) -> Result<Stream, TlsError> {
    let fd = s.fd().map_err(fn (IoError e) => TlsError::Io(e))?;
    let ptr = coil_tls_session_for_fd(fd);
    if ptr == 0 {
        raise TlsError::Io(IoError::InvalidInput);
    }
    coil_tls_disable(ptr, fd, 0);
    return s;
}

// A stream call's failure: `IoError::Protocol` is the native side's own
// certificate or handshake failure, which it names in its last error.
fn stream_failure(IoError e) -> TlsError {
    if e != IoError::Protocol {
        return TlsError::Io(e);
    }
    let name = coil_tls_last_error();
    if name == "Certificate" {
        return TlsError::Certificate;
    }
    return TlsError::Handshake;
}

fn handshake_until_ready(Stream s) -> Result<Stream, TlsError> {
    while true {
        let wbuf: Vec<byte> = Vec::new();
        // Successful empty write is Ready. Empty userland read does not
        // pump (VM returns Ok at capacity 0) so it is not a Ready signal.
        match write(s, wbuf) {
            Result::Ok(_) => {
                return s;
            },
            Result::Err(e) => {
                if e != IoError::WouldBlock {
                    raise stream_failure(e);
                }
            },
        };
        let rbuf: Vec<byte> = Vec::new();
        match read(s, rbuf) {
            Result::Ok(_) => 0,
            Result::Err(e) => {
                if e != IoError::WouldBlock {
                    raise stream_failure(e);
                }
            },
        };
        s.park().map_err(fn (IoError e) => stream_failure(e))?;
    }
}

fn attach_and_handshake(Stream s, int ptr) -> Result<Stream, TlsError> {
    let read_fn = coil_tls_stream_read_fn();
    let write_fn = coil_tls_stream_write_fn();
    let shutdown_fn = coil_tls_stream_shutdown_fn();
    let free_fn = coil_tls_stream_free_fn();
    match s.attach(ptr, read_fn, write_fn, shutdown_fn, free_fn) {
        Result::Ok(attached) => {
            return handshake_until_ready(attached)?;
        },
        Result::Err(e) => {
            coil_tls_free(ptr);
            raise TlsError::Io(e);
        },
    };
}
